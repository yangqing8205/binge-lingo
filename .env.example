# Anthropic-native API endpoint (Messages API). Point this at api.anthropic.com
# or any Anthropic-compatible gateway.
API_BASE_URL=https://api.anthropic.com
API_KEY=sk-your-key-here
API_MODEL=claude-sonnet-4-5

# Notion integration token and target database id.
NOTION_TOKEN=ntn_your_token_here
NOTION_DATABASE_ID=your_database_id_here

# Folder to watch for new screenshots (defaults to ./screenshots)
WATCH_DIR=

# Image host: "notion" (upload via Notion's own file API) or "imgur"
IMAGE_HOST=notion
# Only needed if IMAGE_HOST=imgur
IMGUR_CLIENT_ID=

# Optional proxy for reaching Notion, if your network can't hit api.notion.com
# directly. The LLM endpoint is always called directly, not through this.
HTTPS_PROXY=
